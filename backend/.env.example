# RazorGuard Backend Environment Configuration Template
# DO NOT COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL

# Application Environment
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Security & Secrets (Required: Generate a strong random key in production)
# Example generation: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string

# Analyst Administrative API Key (Protects manual override and rule update endpoints)
ANALYST_API_KEY=replace_with_analyst_secret_api_key
REQUIRE_AUTH_FOR_SENSITIVE_ACTIONS=true

# CORS Configuration (Comma-separated list of allowed origins. Wildcards '*' are prohibited with credentials)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Connection (Default: SQLite for dev. Swap to PostgreSQL for production)
DATABASE_URL=sqlite:///./razorguard.db

# Rate Limiting
RATE_LIMIT_INGESTION=60/minute
RATE_LIMIT_SIMULATE=120/minute

# OpenAI API Configuration (Enrichment Layer Only - Never Decisions)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
AI_ENRICHMENT_ENABLED=true
AI_TIMEOUT_SECONDS=3.0

# Razorpay Test Mode Credentials (NEVER USE PRODUCTION KEYS)
# Obtain test credentials from Razorpay Dashboard -> Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Deterministic Risk Engine Thresholds (Configurable)
RISK_THRESHOLD_REVIEW=40
RISK_THRESHOLD_BLOCKED=70
